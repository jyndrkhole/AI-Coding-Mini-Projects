# Copy to .env and fill in one provider. Never commit .env.
# The rating, ratios, and DCF run without an LLM. A key is only used for commentary.

LLM_PROVIDER=groq

# Option A — Groq. Pick a model your account can call. Do not assume a name stays available.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B — OpenAI. Cursor IDE subscriptions are not an application API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional overrides
# AGENT_TIMEOUT_SECONDS=90
# NEWS_LOOKBACK_DAYS=30
