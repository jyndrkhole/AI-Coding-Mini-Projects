# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# SQLite
DATABASE_PATH=./data/webhook-events.db

# IRI catalogue version (maps to config/iri/<version>/events.json)
IRI_VERSION=v1

# Simulated webhook HTTP response
WEBHOOK_RESPONSE_STATUS=200
WEBHOOK_RESPONSE_DELAY_MS=0

# Optional webhook authentication
WEBHOOK_AUTH_ENABLED=false
WEBHOOK_API_KEY=

# CORS: comma-separated origins, or * for all
CORS_ORIGIN=*

# Request body size limit
BODY_LIMIT=1mb

# Basic rate limiting (webhook endpoint)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
