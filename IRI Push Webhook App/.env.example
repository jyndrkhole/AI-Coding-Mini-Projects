# Server
PORT=3000
NODE_ENV=development
# Public origin shown in Copy URL / curl examples. No trailing slash and no /webhooks/iri.
# Example: https://client-pushconsole.abc.com
PUBLIC_BASE_URL=http://localhost:3000

# SQLite
DATABASE_PATH=./data/webhook-events.db

# IRI catalogue version (maps to config/iri/<version>/events.json)
IRI_VERSION=v1

# Simulated webhook HTTP response
WEBHOOK_RESPONSE_STATUS=200
WEBHOOK_RESPONSE_DELAY_MS=0

# Optional webhook authentication
WEBHOOK_AUTH_ENABLED=false
WEBHOOK_API_KEY=

# Portal UI login (does not apply to POST /webhooks/iri)
PORTAL_AUTH_ENABLED=false
PORTAL_USERNAME=admin
PORTAL_PASSWORD=
# How long the portal cookie lasts after Sign in. Default 1 hour.
PORTAL_SESSION_TTL_HOURS=1
# Optional short override for local testing (wins over hours). Example: 1
# PORTAL_SESSION_TTL_MINUTES=1

# CORS: comma-separated origins, or * for all
CORS_ORIGIN=*

# Request body size limit
BODY_LIMIT=1mb

# Basic rate limiting (webhook endpoint)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Source platform read APIs used by Reconcile and Get by event id.
# Set PORTAL_ENVIRONMENT to QA, INT, or PROD. The portal uses only that environment's URL.
# No trailing slash. The user enters the source x-api-key in the portal.
# The portal calls:
#   POST {source URL}/getAuthToken                                          header: x-api-key
#   GET  {source URL}/v1/application-notifications/reconciliation           header: Authorization
#   GET  {source URL}/v1/application-notifications/{eventId}                header: Authorization
PORTAL_ENVIRONMENT=
SOURCE_API_BASE_URL_QA=
SOURCE_API_BASE_URL_INT=
SOURCE_API_BASE_URL_PROD=
# Optional single-URL override. When set, it wins over the environment URL above.
SOURCE_API_BASE_URL=
# Optional server-side fallback. Leave blank so each user enters the source x-api-key in the portal.
SOURCE_API_KEY=
