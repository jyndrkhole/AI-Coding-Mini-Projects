{
  "name": "iri-push-notification-test-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Internal test harness / dummy webhook receiver for IRI Application Status Push Notifications",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm run dev --prefix frontend",
    "build": "tsc --noEmit && npm run build --prefix frontend",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.17",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
