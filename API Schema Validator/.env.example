GROQ_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
GROQ_MODEL=llama-3.3-70b-versatile
MAX_PAYLOAD_SIZE_MB=20
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Privacy / data residency (strict = nothing leaves this machine)
PRIVACY_MODE=strict
ALLOW_REMOTE_SCHEMA_FETCH=false
ALLOW_CLOUD_LLM=false
ALLOW_LOCAL_LLM=true
LOG_PAYLOADS=false
