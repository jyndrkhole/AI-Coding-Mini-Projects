# Copy to .env. Never commit the real file.
# Groq is the default OpenAI-compatible provider. OpenAI is used only if GROQ_API_KEY is empty.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SQLITE_PATH=./data/sqlite/tripwise.db
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
KNOWLEDGE_PATH=./data/knowledge
JWT_SECRET=change-me-before-sharing-this-app
JWT_EXPIRE_MINUTES=10080
SIMILARITY_THRESHOLD=0.28
RETRIEVAL_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_TOOL_STEPS=8
AGENT_TIMEOUT_SECONDS=90
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_BYTES=5000000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=600
