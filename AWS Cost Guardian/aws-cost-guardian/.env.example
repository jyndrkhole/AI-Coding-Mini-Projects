# Demo mode uses the checked-in sample account and does not call AWS.
MOCK_AWS=true

# SQLite file used in local development. Override with a PostgreSQL URL later.
# DATABASE_URL=sqlite:///./backend/data/aws_cost_guardian.db

AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=

API_CORS_ORIGINS=http://localhost:5173
