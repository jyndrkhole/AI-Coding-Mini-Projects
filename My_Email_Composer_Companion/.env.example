# Application
APP_NAME=Email Intelligence Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (relative paths are resolved against project root, not process cwd)
DATABASE_URL=sqlite+aiosqlite:///./data/email_ai.db

# LLM Provider: groq | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings: local | ollama
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=onnx-minilm-l6-v2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
VECTOR_DB_PATH=./vector_db
UPLOAD_DIR=./uploads
WORKSPACES_DIR=./workspaces

# Paths
PROMPTS_DIR=./prompts
LOGS_DIR=./logs
